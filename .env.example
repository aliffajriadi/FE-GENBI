# Kosongkan: browser memanggil API lewat proxy Next di port yang sama (aman untuk HP, LAN, tunnel, HTTPS).
# Isi hanya kalau API punya domain sendiri, mis. https://api.genbi.id/api/v1
NEXT_PUBLIC_API_URL=
# Alamat backend yang dihubungi server Next (proxy + render halaman publik)
BACKEND_URL="http://localhost:4000"
